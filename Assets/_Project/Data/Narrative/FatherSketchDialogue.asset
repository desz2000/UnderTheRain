  m_Script: {fileID: 11500000, guid: e34911543f3afc840847ab575f1d0587, type: 3}
  m_Name: FatherSketchDialogue
  m_EditorClassIdentifier: UnderTheRain.Runtime::UnderTheRain.Narrative.DialogueSequenceSO
  lines:
  - speakerName: "RABISCO \xC0 M\xC3O"
    speakerColor: {r: 0.95, g: 0.78, b: 0.45, a: 1}
    text: "Um papel dobrado, preso na grade: o esquema de um circuito de isolamento,
      cheio de setas e corre\xE7\xF5es apressadas."
  - speakerName: DANTE
    speakerColor: {r: 0.75, g: 0.9, b: 0.96, a: 1}
    text: "Essa letra... \xE9 do meu pai. Ele esteve aqui."
